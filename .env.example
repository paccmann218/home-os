# Copy to .env (gitignored) and fill in.
# Azure OpenAI (v1 endpoint) for agent reasoning + embeddings
AZURE_OPENAI_BASE_URL=https://<resource>.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small
# Sarvam voice (Saaras STT + Bulbul TTS). Empty = watch uses its own on-device speech.
SARVAM_API_KEY=
# FalkorDB
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
HOMEOS_AGENT_PASSWORD=homeos-agent
# Household + room hardware
HOMEOS_PEOPLE=harsh,shashwath
ESP32_HOST=
WIZ_HOST=
# Features
HOMEOS_FALKORDB_MCP=on      # also give agents the official FalkorDB MCP server (read-only)
HOMEOS_RECORD=on            # record real sessions for replay mode
HOMEOS_GRAPH=on             # off = ablation (fixed rules, no FalkorDB)
HOMEOS_EVAL_WINDOW_SEC=180  # how long after an action the evaluator measures the body
