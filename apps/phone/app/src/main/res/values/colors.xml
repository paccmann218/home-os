<?xml version="1.0" encoding="utf-8"?>
<!--
    The few palette values the platform needs from outside Compose: the window behind a cold start,
    the splash background, and the notification card. Every one of them is a token that also exists
    in theme/Color.kt and they have to stay in step — a window background one shade off its Compose
    counterpart shows up as a flash on every single launch.
-->
<resources>
    <color name="shell">#FF5EC9C0</color>
    <color name="shell_raised">#FF141C1D</color>
    <color name="shell_sunk">#FF030707</color>
    <color name="on_shell">#FF131719</color>
    <color name="on_shell_muted">#FF3F4347</color>
    <color name="teal">#FF60D3CD</color>
    <!-- The notification card keeps the dark surface it was designed with: it is rendered in
         the system shade, not on the app's field. -->
    <color name="notif_text">#FFE6ECEC</color>
    <color name="notif_text_muted">#FFA6B3B3</color>
    <color name="transparent">#00000000</color>
</resources>
