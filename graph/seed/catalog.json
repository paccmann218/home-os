{
  "_comment": "Seed knowledge for HomeOS. Home graph: rooms, devices, what each device controls and what that does to the body (literature priors). Body graphs: default conditions, comfort preferences, intervention catalogue and weak evidence priors. Everything here is editable at runtime (by voice or by learning) - it is data, not code. Condition priority decides whose comfort range wins when ranges conflict (a sick person's floor beats a post-workout ceiling); only the number is shared, never the reason.",
  "rooms": [
    {
      "id": "bedroom",
      "name": "Bedroom"
    }
  ],
  "devices": [
    {
      "id": "ac",
      "room": "bedroom",
      "kind": "ac",
      "driver": "virtual",
      "name": "Air conditioner",
      "min": 18,
      "max": 30,
      "state": {
        "power": "off",
        "setpoint": 26
      }
    },
    {
      "id": "fan",
      "room": "bedroom",
      "kind": "fan",
      "driver": "virtual",
      "name": "Fan",
      "min": 0,
      "max": 3,
      "state": {
        "power": "off",
        "level": 0
      }
    },
    {
      "id": "light",
      "room": "bedroom",
      "kind": "light",
      "driver": "esp32",
      "name": "Room light (ESP32 LED)",
      "min": 0,
      "max": 100,
      "state": {
        "power": "off",
        "brightness": 0
      }
    },
    {
      "id": "bulb",
      "room": "bedroom",
